# ToolsGift environment variables — NAMES AND INSTRUCTIONS ONLY.
# Copy to .env.local for development and set the real values in Vercel
# Project Settings > Environment Variables for production. Never commit
# real values.

# Vercel Blob (Auth store + file tools)
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=

# OIDC token exchange for server-to-server calls (Vercel)
VERCEL_OIDC_TOKEN=

# Secret used to sign session, password-reset and OAuth state cookies.
# Keep private. Generate with: openssl rand -base64 48
AUTH_SECRET=

# Google OAuth 2.0 / OpenID Connect ("Continue with Google").
# Create at https://console.cloud.google.com/apis/credentials
# - Application type: "Web application"
# - Authorized JavaScript origins: your site origin (e.g. http://localhost:3000
#   and https://your-domain.vercel.app)
# - Authorized redirect URIs: <origin>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
